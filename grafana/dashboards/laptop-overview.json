{
  "uid": "laptop-overview",
  "title": "Laptop Overview",
  "description": "my laptops host metrics. node exporter collects them and prometheus stores them",
  "tags": ["laptop", "node-exporter"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": { "from": "now-3h", "to": "now" },
  "panels": [

    { "type": "row", "title": "Overview", "collapsed": false, "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_time_seconds - node_boot_time_seconds", "legendFormat": "uptime", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "none", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "gauge",
      "title": "CPU busy",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "busy", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "type": "gauge",
      "title": "Memory used",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "used", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "type": "gauge",
      "title": "Root disk used",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})", "legendFormat": "/", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "type": "gauge",
      "title": "Battery",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_power_supply_capacity{power_supply=~\"BAT.*\"}", "legendFormat": "{{power_supply}}", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 25 }, { "color": "green", "value": 50 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Load (1m)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_load1", "legendFormat": "load1", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 8 }, { "color": "red", "value": 16 }
          ] }
        },
        "overrides": []
      }
    },

    { "type": "row", "title": "CPU", "collapsed": false, "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },

    {
      "type": "timeseries",
      "title": "CPU by mode",
      "description": "where the cpu time actually goes. stacked so the total is how busy it is overall",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "avg by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) * 100", "legendFormat": "{{mode}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0,
          "custom": { "fillOpacity": 40, "lineWidth": 1, "showPoints": "never",
                      "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Per-core busy",
      "description": "one line per core. an average hides it when just one core is pegged, this doesnt",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 - (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]) * 100)", "legendFormat": "core {{cpu}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "custom": { "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "CPU frequency",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_cpu_scaling_frequency_hertz", "legendFormat": "core {{cpu}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "hertz", "custom": { "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Load average",
      "description": "runnable plus uninterruptible processes. compare it against my 16 cores",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_load1", "legendFormat": "1m", "refId": "A" },
        { "expr": "node_load5", "legendFormat": "5m", "refId": "B" },
        { "expr": "node_load15", "legendFormat": "15m", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "Memory", "collapsed": false, "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 } },

    {
      "type": "timeseries",
      "title": "Memory breakdown",
      "description": "cache and buffers can be reclaimed so a big cache is normal linux, not a problem",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemFree_bytes - node_memory_Buffers_bytes - node_memory_Cached_bytes", "legendFormat": "used", "refId": "A" },
        { "expr": "node_memory_Cached_bytes", "legendFormat": "cached", "refId": "B" },
        { "expr": "node_memory_Buffers_bytes", "legendFormat": "buffers", "refId": "C" },
        { "expr": "node_memory_MemFree_bytes", "legendFormat": "free", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes", "min": 0,
          "custom": { "fillOpacity": 50, "lineWidth": 1, "showPoints": "never",
                      "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Swap",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes", "legendFormat": "used", "refId": "A" },
        { "expr": "node_memory_SwapTotal_bytes", "legendFormat": "total", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "Disk", "collapsed": false, "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 } },

    {
      "type": "timeseries",
      "title": "Disk throughput",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_disk_read_bytes_total[5m])", "legendFormat": "{{device}} read", "refId": "A" },
        { "expr": "rate(node_disk_written_bytes_total[5m])", "legendFormat": "{{device}} write", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Disk IOPS",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_disk_reads_completed_total[5m])", "legendFormat": "{{device}} reads", "refId": "A" },
        { "expr": "rate(node_disk_writes_completed_total[5m])", "legendFormat": "{{device}} writes", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "iops", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Disk utilisation",
      "description": "how much of the time the disk had at least one request in flight. stuck at 100 means the disk is what is slowing me down",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_disk_io_time_seconds_total[5m]) * 100", "legendFormat": "{{device}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Filesystem used",
      "description": "max by (device) collapses the btrfs subvolumes, otherwise my one ssd shows up seven times",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 * (1 - max by (device) (node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs\"}) / max by (device) (node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs\"}))", "legendFormat": "{{device}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 }
          ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Filesystem free space",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "max by (device) (node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs\"})", "legendFormat": "{{device}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "Network", "collapsed": false, "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 } },

    {
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total[5m])", "legendFormat": "{{device}} rx", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total[5m])", "legendFormat": "{{device}} tx", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Network packets",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_network_receive_packets_total[5m])", "legendFormat": "{{device}} rx", "refId": "A" },
        { "expr": "rate(node_network_transmit_packets_total[5m])", "legendFormat": "{{device}} tx", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "pps", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Network errors and drops",
      "description": "should just sit flat on zero. if it starts climbing theres something actually wrong with the link",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_network_receive_errs_total[5m])", "legendFormat": "{{device}} rx errs", "refId": "A" },
        { "expr": "rate(node_network_transmit_errs_total[5m])", "legendFormat": "{{device}} tx errs", "refId": "B" },
        { "expr": "rate(node_network_receive_drop_total[5m])", "legendFormat": "{{device}} rx drops", "refId": "C" },
        { "expr": "rate(node_network_transmit_drop_total[5m])", "legendFormat": "{{device}} tx drops", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "pps", "min": 0, "custom": { "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "Hardware", "collapsed": false, "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 62 } },

    {
      "type": "timeseries",
      "title": "Battery charge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 63 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_power_supply_capacity{power_supply=~\"BAT.*\"}", "legendFormat": "{{power_supply}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "type": "stat",
      "title": "Power source",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 63 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_power_supply_online{power_supply=\"ACAD\"}", "legendFormat": "AC", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "On battery", "color": "orange", "index": 0 },
              "1": { "text": "Plugged in", "color": "green", "index": 1 }
            } }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Thermal zones",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 63 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_thermal_zone_temp", "legendFormat": "{{type}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }
          ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Hardware sensors (hwmon)",
      "description": "cpu package, nvme and chipset sensors, read straight out of /sys/class/hwmon",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 71 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_hwmon_temp_celsius", "legendFormat": "{{chip}} / {{sensor}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }
          ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "type": "row", "title": "Pressure (PSI)", "collapsed": false, "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 79 } },

    {
      "type": "timeseries",
      "title": "Resource pressure",
      "description": "how long things were stalled waiting on a resource. not the same as utilisation, a disk can sit at 100% with no pressure at all if only one process wants it",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 80 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_pressure_cpu_waiting_seconds_total[5m]) * 100", "legendFormat": "cpu", "refId": "A" },
        { "expr": "rate(node_pressure_io_waiting_seconds_total[5m]) * 100", "legendFormat": "io", "refId": "B" },
        { "expr": "rate(node_pressure_memory_waiting_seconds_total[5m]) * 100", "legendFormat": "memory", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
