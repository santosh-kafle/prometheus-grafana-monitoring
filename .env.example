GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=set_your_password_here

# optional, uncomment to change
# 127.0.0.1 = only this machine can open grafana
# 0.0.0.0   = any device on your home network can (needs a firewall rule if ufw/firewalld is on)
#GRAFANA_BIND_ADDR=127.0.0.1
#GRAFANA_PORT=3000
